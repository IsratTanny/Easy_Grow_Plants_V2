# ─── Easy Grow Plants — Django backend configuration ───
# Copy this file to ".env" (same folder) and adjust as needed.
# For local development the defaults below are fine; you can even skip the copy.

# Secret key — generate a fresh random value for any real deployment.
DJANGO_SECRET_KEY=django-insecure-change-me-in-production

# Debug mode. Keep True for local dev; set False in production.
DJANGO_DEBUG=True

# Comma-separated allowed hosts (only enforced when DEBUG=False).
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Comma-separated CORS allow-list (when set, overrides the dev "allow all").
# DJANGO_CORS_ORIGINS=http://localhost:5173

# Extra CSRF trusted origins (comma-separated), if serving from another host.
# DJANGO_CSRF_TRUSTED_ORIGINS=

# Gemini API key for plant detection + chatbot (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
