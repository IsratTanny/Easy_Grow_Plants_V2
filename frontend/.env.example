# ─── Easy Grow Plants — frontend dev-server configuration ───
# Copy to ".env" only if you need to override the defaults below.

# URL of the running Django backend. The Vite dev server proxies /api and
# /media to this target. Default assumes the backend runs on port 8000.
VITE_BACKEND_URL=http://127.0.0.1:8000

# URL of the optional IoT FastAPI service (proxied at /iot). Optional.
VITE_IOT_URL=http://127.0.0.1:8001
